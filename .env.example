DB_HOST=
DB_PORT=
DB_NAME=
SUPPLY_DB_NAME=
REFERENCE_DB_NAME=
WAREHOUSE_DB_NAME=
# Отдельные БД и домены для каждого сайта:
# TENANTS=FIRST,EFIMOV
# TENANT_FIRST_HOSTS=supply.st29.ru
# TENANT_FIRST_COOKIE_NAME=session
# TENANT_FIRST_DB_NAME=authorization_service
# TENANT_FIRST_SUPPLY_DB_NAME=supply_service
# TENANT_FIRST_REFERENCE_DB_NAME=reference_service
# TENANT_FIRST_WAREHOUSE_DB_NAME=warehouse_service
# TENANT_EFIMOV_HOSTS=efimov.st29.ru
# TENANT_EFIMOV_COOKIE_NAME=session_efimov
# TENANT_EFIMOV_DB_NAME=authorization_service_efimov
# TENANT_EFIMOV_SUPPLY_DB_NAME=supply_service_efimov
# TENANT_EFIMOV_REFERENCE_DB_NAME=reference_service_efimov
# TENANT_EFIMOV_WAREHOUSE_DB_NAME=warehouse_service_efimov
DB_USER=
DB_PASSWORD=
SUPPLY_REQUEST_FILES_DIR=
SUPPLY_INVOICE_FILES_DIR=
SYNC_LOG_DIR=
MISTRAL_API_KEY=
SSL_CERT_PATH=/path/to/your/cert.pem
SSL_KEY_PATH=/path/to/your/key.pem
MISTRAL_OBJECT_NAME_API_KEY=
MISTRAL_CONTRACT_EXTRACT_API_KEY=
MISTRAL_INVOICE_EXTRACT_API_KEY=
# Directory for receipt photos (one sub-folder per receipt); default: ./storage/receipts
SUPPLY_RECEIPT_FILES_DIR=
# Public URL of that directory, e.g. https://supply.st29.ru/storage/receipts (empty = API links only)
SUPPLY_RECEIPT_FILES_URL=
# Token of proverkacheka.com (receipt data by QR code / photo)
PROVERKACHEKA_TOKEN=
# Reserve keys: used one after another when the previous one reports its limit is exhausted
PROVERKACHEKA_TOKEN_2=
PROVERKACHEKA_TOKEN_3=
# Mistral key for picking receipt categories by positions (empty = the feature is skipped); model: RECEIPT_CATEGORY_MODEL (default ministral-8b-2512)
MISTRAL_RECEIPT_CATEGORY_API_KEY=
# Receipt seller logos: directory and its public URL (empty URL = logos are served by the API)
SUPPLY_RECEIPT_LOGOS_DIR=
SUPPLY_RECEIPT_LOGOS_URL=
# Model for the opt-in mistral_ocr provider; empty = mistral-ocr-4-1
MISTRAL_OCR_MODEL=
# Order document recognition providers are tried in (comma separated); empty = vision,pixtral.
# Opt-in extra: mistral_ocr (needs OCR quota on the Mistral account)
DOCUMENT_OCR_ORDER=
# Fast vision model for document recognition; empty = ministral-3b-2512, "off" = skip it
DOCUMENT_VISION_MODEL=
# Transcription prompt: empty = full (verbatim, reliable); lean = skips legal boilerplate, ~2x faster but may silently drop totals
DOCUMENT_OCR_PROMPT=

# Общий журнал ЭДО размещается в БД снабжения указанного сайта.
EDO_HUB_TENANT=FIRST
# * — все авторизованные пользователи; либо список user_id через запятую.
TENANT_FIRST_EDO_USERS=*
TENANT_EFIMOV_EDO_USERS=*
# Максимальный общий размер файлов одной отправки (8 МиБ по умолчанию).
EDO_MAX_DOCUMENT_BYTES=8388608

# Native iOS push (APNs). Keep the .p8 file outside the repository.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=
CHAT_PUBLIC_API_PREFIX=/apisup/supply

# Groq invoice recognition (set the real key only in .env).
GROQ_API_KEY=
GROQ_INVOICE_MODEL=qwen/qwen3.8-27b

CHECKO_API_KEY=
